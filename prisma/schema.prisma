generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Locale {
  en
  de
  es
}

enum Role {
  student
  instructor
  admin
}

enum Duration {
  ONE_HOUR
  TWO_HOURS
  INTENSIVE
  FULL_DAY
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT_FREESTYLE
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED_BY_USER
  CANCELLED_BY_OPS
  CANCELLED_BY_SYSTEM
  PAYMENT_FAILED
  REFUNDED
}

enum AvailabilityKind {
  AVAILABLE
  BLOCKED
}

enum CreditReason {
  USER_CANCEL
  OPS_CANCEL
}

enum CreditStatus {
  ACTIVE
  LOCKED
  USED
  EXPIRED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  image         String?
  locale        Locale   @default(en)
  roles         Role[]   @default([student])
  phone         String?
  preferences   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions       Session[]
  accounts       Account[]
  instructor     Instructor?
  bookings       Booking[]
  accountCredits AccountCredit[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Instructor {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  photo                  String?
  bio                    String?  @db.Text
  specialties            String[]
  languages              Locale[]
  active                 Boolean  @default(true)
  acceptsSameDayIfBooked Boolean  @default(false)
  calendarConnected      Boolean  @default(false)
  googleRefreshToken     String?
  createdAt              DateTime @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilityBlocks AvailabilityBlock[]
  bookings           Booking[]
  tips               Tip[]
}

model AvailabilityBlock {
  id            String           @id @default(cuid())
  instructorId  String
  startDateTime DateTime
  endDateTime   DateTime
  kind          AvailabilityKind

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId, startDateTime])
  @@index([startDateTime, endDateTime])
}

/// Season holds operational config for a booking period (start/end dates,
/// anchor times, operating hours). No FK from Booking → Season on purpose:
/// the booking engine derives the active Season from `Booking.date` at query
/// time, so a FK would be redundant and would require a backfill if season
/// boundaries ever shift.
model Season {
  id                        String   @id @default(cuid())
  name                      String
  startDate                 DateTime @db.Date
  endDate                   DateTime @db.Date
  active                    Boolean  @default(true)
  /// 24h "HH:MM" strings, e.g. ["09:00","11:00","13:00","15:00"].
  /// Order does not matter; the booking engine sorts.
  anchorTimes               String[]
  /// 24h "HH:MM" — earliest start time a class may begin in this season.
  operatingHoursStart       String
  /// 24h "HH:MM" — latest end time a class may end in this season.
  operatingHoursEnd         String
  /// CHF cents (VAT inclusive) per Duration enum value. Invariant: every
  /// active Season MUST populate all four keys (ONE_HOUR, TWO_HOURS,
  /// INTENSIVE, FULL_DAY). Read via lib/pricing/get-price.ts which throws
  /// on missing keys so a misseeded row fails fast at booking time.
  /// `@default("{}")` exists only to make the ADD COLUMN migration safe on
  /// the existing Season row; the seed overwrites with real prices right
  /// after migrate runs.
  priceCentsByDuration      Json     @default("{}")
  /// F-141: optional promotional price in CHF cents per Duration. Partial map —
  /// only promoted durations appear (e.g. `{ "ONE_HOUR": 9500 }`). Invariant
  /// enforced on write (lib/schemas/pricing.ts) AND defensively on read
  /// (lib/pricing/get-price.ts:resolvePriceCents): a promo is honored only when
  /// present, an integer, and strictly below the regular price. Nullable so the
  /// ADD COLUMN migration is safe and "no promotions" is the natural default.
  promoPriceCentsByDuration Json?
  /// F-141: localized promo copy per promoted Duration —
  /// `Partial<Record<Duration, { en: string; de: string; es: string }>>`, e.g.
  /// `{ "ONE_HOUR": { "en": "Season opening", "de": "…", "es": "…" } }`. Every
  /// key present here MUST have all three non-empty strings and a matching entry
  /// in `promoPriceCentsByDuration` (admin validation guarantees both).
  promoLabelByDuration      Json?

  @@index([active, startDate, endDate])
}

/// AdBanner (F-142) — the home hero announcement band, owner-authored via the
/// admin panel (replaces the F-053 messages-only band). Multiple enabled
/// banners rotate on the home; a banner is mandatory while any promotion is
/// active (cross-checked in lib/admin/pricing.ts + lib/admin/announcements.ts).
model AdBanner {
  id        String   @id @default(cuid())
  enabled   Boolean  @default(true)
  /// Display + rotation order (ascending). Ties broken by createdAt.
  sortIndex Int      @default(0)
  /// `{ en: string; de: string; es: string }` — all three non-empty.
  body      Json
  /// `{ en: string; de: string; es: string } | null` — optional CTA label per
  /// locale. When set, all three are non-empty and `ctaHref` is present.
  ctaLabel  Json?
  /// Internal path ("/reservar", "/precios") or an allow-listed external URL;
  /// validated via lib/hero-announcement.ts:isAllowedCtaHref before persisting.
  ctaHref   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortIndex])
}

model Booking {
  id                         String        @id @default(cuid())
  bookerId                   String
  instructorId               String
  date                       DateTime      @db.Date
  anchorTime                 String
  duration                   Duration
  language                   Locale
  // F-140: the contact phone the booker entered in the funnel for THIS booking
  // (E.164). Snapshot per booking so the ops/instructor email shows exactly what
  // they typed, even if their profile User.phone differs or was set earlier.
  // Nullable only for legacy rows created before this column existed.
  bookerPhone                String?
  status                     BookingStatus
  totalPriceCents            Int
  // F-084: net amount actually charged via Stripe (totalPriceCents minus credits
  // applied at checkout). Persisted so the resume-payment flow knows what to bill
  // without re-reading the Stripe PaymentIntent. Null for legacy rows + the
  // zero-charge path (charge is 0); resume falls back to totalPriceCents when null.
  chargeAmountCents          Int?
  // F-084: total credit value applied to this booking at draft creation. Snapshot
  // for display / audit; the authoritative credit ledger lives in AccountCredit.
  creditsAppliedCents        Int?
  // F-141: promo snapshot. `totalPriceCents` is always the CHARGED (effective)
  // price. `originalPriceCents` holds the pre-promo regular price, set only when
  // a promotion applied at booking time (else null) — so post-purchase surfaces
  // (funnel summary, success page, email, dashboard) can render the struck-through
  // original without re-reading the season, staying correct after the promo is
  // later edited or removed. `promoLabel` is the resolved copy in the booking's
  // own `language`, snapshotted the same way.
  originalPriceCents         Int?
  promoLabel                 String?
  // F-155: promo-code snapshot. `discountCodeId` links the DiscountCode the
  // booker applied (null = none); `discountCents` is the CHF-cents amount that
  // code took off the lesson at draft time. Snapshot per booking (like
  // creditsAppliedCents) so resume-payment + the success/email surfaces stay
  // correct without re-reading the code — and immune to a later admin edit of
  // the code's percentage/amount. The charge order is promo THEN credits:
  // chargeAmountCents = max(0, (totalPriceCents - discountCents) - creditsAppliedCents).
  // This (bookerId, discountCodeId, status) is also the redemption ledger: the
  // once-per-customer limit is a count over non-cancelled bookings carrying the
  // code, so no separate redemption table is needed.
  discountCodeId             String?
  discountCents              Int?
  stripePaymentIntentId      String?       @unique
  icsUid                     String        @unique
  googleEventId              String?
  notes                      String?       @db.Text
  cancelledByUserAt          DateTime?
  cancelledByOpsAt           DateTime?
  opsReason                  String?
  paidAt                     DateTime?
  refundedAt                 DateTime?
  refundAmountCents          Int?
  /// F-078: Stripe refund id for ops-cancellations of cash-paid bookings.
  /// Persisted so the action is idempotent — a second `cancelBookingByOps`
  /// call sees the booking already CANCELLED_BY_OPS + the refund id set
  /// and short-circuits without re-hitting Stripe.
  stripeRefundId             String?       @unique
  failureReason              String?       @db.Text
  confirmationEmailSentAt    DateTime?
  /// F-140: guards the ops/instructor "new booking" notification, sent to the
  /// instructor + admin alongside the booker confirmation. Separate from
  /// confirmationEmailSentAt so a booker-email success can't suppress the notif
  /// (and vice versa). Mirrors opsCancellationNotifSentAt on the cancel side.
  opsBookingNotifSentAt      DateTime?
  reminder24hSentAt          DateTime?
  postClassEmailSentAt       DateTime?
  cancellationEmailSentAt    DateTime?
  opsCancellationNotifSentAt DateTime?
  autoCompletedAt            DateTime?
  /// F-065: instructor's private, internal-only note on a COMPLETED class
  /// (progress, real level observed, preferences, warnings). Never shown to
  /// the booker. `instructorNoteSetAt` tracks the last edit; both are cleared
  /// together when the note is emptied.
  instructorNote             String?       @db.Text
  instructorNoteSetAt        DateTime?
  createdAt                  DateTime      @default(now())

  booker          User            @relation(fields: [bookerId], references: [id], onDelete: Restrict)
  instructor      Instructor      @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  attendees       Attendee[]
  tip             Tip?
  creditsSourced  AccountCredit[] @relation("CreditSource")
  creditsRedeemed AccountCredit[] @relation("CreditRedemption")
  creditsLocking  AccountCredit[] @relation("CreditLock")
  discountCode    DiscountCode?   @relation(fields: [discountCodeId], references: [id], onDelete: Restrict)

  @@index([bookerId, status])
  @@index([instructorId, date])
  @@index([date, status])
  // F-155: backs the redemption counts (global + once-per-customer) in
  // lib/booking/discount.ts, which filter bookings by discountCodeId + status.
  @@index([discountCodeId, status])
}

/// DiscountCode (F-155) — an owner-authored promo code a booker types in the
/// funnel (step before payment) to take a percentage or a fixed CHF amount off
/// the lesson price. A code carries EITHER `percentOff` (1..100) OR
/// `amountOffCents` (never both — enforced in lib/schemas/discount-code.ts and
/// applied defensively in lib/booking/discount.ts). `maxRedemptions` is an
/// OPTIONAL global cap (null = unlimited); a once-per-customer limit is always
/// enforced. No redemption table: Booking.discountCodeId + status is the ledger.
///
/// Designed to extend to referral codes later (F-referral): add `kind` +
/// `referrerUserId` here and mint an AccountCredit for the referrer when a
/// booking carrying a referral code is CONFIRMED — purely additive, no reshape.
model DiscountCode {
  id             String   @id @default(cuid())
  /// Normalized UPPERCASE, e.g. "VERGANI". Matched case-insensitively (the
  /// booker's input is upper-cased before lookup). Unique across all codes.
  code           String   @unique
  /// Optional internal note for the admin list (e.g. "Vergani influencer").
  /// Never shown to the booker.
  label          String?
  /// Percentage off (1..100). Exactly one of percentOff / amountOffCents is set.
  percentOff     Int?
  /// Fixed CHF cents off. Clamped to the lesson price at apply time so the
  /// charge never goes negative. Exactly one of percentOff / amountOffCents.
  amountOffCents Int?
  /// Optional global redemption cap (null = unlimited). Counted over bookings
  /// carrying this code in non-cancelled statuses.
  maxRedemptions Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings Booking[]

  @@index([active])
}

/// Attendee = a person attending a class. The booker (Booking.bookerId)
/// is NOT automatically an attendee — e.g. a parent paying for kids.
/// At most ONE attendee per booking may have isBooker = true; this is
/// enforced by a partial unique index added in a follow-up migration
/// (see `20260518090000_attendee_booker_unique`).
model Attendee {
  id        String   @id @default(cuid())
  bookingId String
  name      String
  birthDate DateTime @db.Date
  level     Level
  isBooker  Boolean  @default(false)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model AccountCredit {
  id                String       @id @default(cuid())
  userId            String
  amountCents       Int
  sourceBookingId   String
  usedOnBookingId   String?
  lockedByBookingId String?
  reason            CreditReason
  status            CreditStatus
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime     @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceBooking   Booking  @relation("CreditSource", fields: [sourceBookingId], references: [id])
  usedOnBooking   Booking? @relation("CreditRedemption", fields: [usedOnBookingId], references: [id])
  lockedByBooking Booking? @relation("CreditLock", fields: [lockedByBookingId], references: [id])

  @@index([userId, status])
  @@index([status, expiresAt])
}

model Tip {
  id                    String   @id @default(cuid())
  bookingId             String   @unique
  instructorId          String
  amountCents           Int
  stripePaymentIntentId String   @unique
  paidAt                DateTime
  requestEmailSentAt    DateTime

  booking    Booking    @relation(fields: [bookingId], references: [id])
  instructor Instructor @relation(fields: [instructorId], references: [id])

  @@index([instructorId, paidAt])
}

/// Idempotency ledger for inbound provider webhooks (Stripe today, room for
/// Resend / Google later). Architecture.md ADR-006: insert on receipt with
/// `skipDuplicates`; if the row already exists, the webhook is a retry and
/// we return 200 without re-processing. `processedAt` is set only after the
/// handler finishes successfully so a crash mid-processing leaves the row
/// re-claimable by manual replay.
model WebhookEvent {
  /// Provider event id (Stripe `event.id`). Globally unique per provider.
  id          String    @id
  /// Source provider — "stripe" for now. Lowercase, kebab-stable.
  source      String
  /// Event type for debugging / dashboards (e.g. "payment_intent.succeeded").
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([source, receivedAt])
}
